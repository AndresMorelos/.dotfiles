# Base: everything every machine gets, personal or client.

# Modern CLI replacements
brew "bat"
brew "ripgrep"
brew "fd"
brew "sd"
brew "eza"
brew "duf"
brew "jq"
brew "ack"

# Shell + prompt
brew "starship"

# Version managers
brew "fnm"
brew "pyenv"

# Code intelligence and refactoring
brew "ast-grep"                    # search and rewrite by AST, not by regex
brew "typescript-language-server"  # backs the typescript-lsp Claude Code plugin
brew "typescript"                  # tsserver, which the language server wraps

# Core tooling
brew "gh"          # required to clone this private repo on a new Mac
brew "shellcheck"  # required by the lint step in README
brew "shfmt"       # the formatter to go with the linter
brew "fzf"
brew "git-delta"   # readable diffs, matching the tracked iTerm colours
brew "direnv"      # per-project environment without polluting .zshrc
brew "git"
brew "git-lfs"
brew "gnupg"
brew "wget"
brew "yarn"
brew "pnpm"

cask "appcleaner"
