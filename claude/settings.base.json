{
  "model": "opus",
  "outputStyle": "Gentleman",
  "effortLevel": "medium",
  "theme": "dark",
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf ~)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "PLACEHOLDER-rewritten-at-link-time",
    "padding": 0
  }
}
